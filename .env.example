# ── Supabase (Auth) — Project Settings → API ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Opsional: true = wajib login sebelum bayar (default: tamu tetap bisa pesan)
NEXT_PUBLIC_REQUIRE_LOGIN_TO_BOOK=false

# ── QRIS ──
# true = tombol "Bayar via QRIS" aktif di form pesan (kosong/false = mati, tampil "sedang gangguan")
NEXT_PUBLIC_QRIS_ENABLED=false
# String QRIS statis (hasil scan stiker QRIS merchant, diawali 000201...)
NEXT_PUBLIC_QRIS_STATIC=

# Fonnte (WhatsApp) — dapatkan di fonnte.com → Dashboard → Token
FONNTE_TOKEN=

# ── Sistem Ulasan ──
# Supabase → Project Settings → API → "service_role" (RAHASIA, jangan pakai NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# String acak panjang (≥16 karakter). Vercel otomatis mengirimnya sebagai "Authorization: Bearer ..." ke cron.
# Buat dengan: openssl rand -hex 32
CRON_SECRET=
# Opsional: dasar URL di email ulasan (default https://bengkulutravel.com)
NEXT_PUBLIC_SITE_URL=https://bengkulutravel.com
