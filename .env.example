# ── Supabase (Auth) — Project Settings → API ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Opsional: true = wajib login sebelum bayar (default: tamu tetap bisa pesan)
NEXT_PUBLIC_REQUIRE_LOGIN_TO_BOOK=false

# Fonnte (WhatsApp) — dapatkan di fonnte.com → Dashboard → Token
FONNTE_TOKEN=
