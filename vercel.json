{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bengkulutravel.com"
        }
      ],
      "destination": "https://bengkulutravel.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/send-review-requests",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/purge-expired-tickets",
      "schedule": "0 2 * * *"
    }
  ]
}
