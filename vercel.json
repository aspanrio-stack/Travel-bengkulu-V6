{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bengkulutravel.com"
        }
      ],
      "destination": "https://bengkulutravel.com/:path*",
      "permanent": true
    },
    {
      "source": "/admin/login",
      "destination": "/admin",
      "permanent": false
    }
  ]
}
